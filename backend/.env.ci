# Continuous integration configuration
# Application
APP_NAME="Docker Fullstack Boilerplate"
APP_VERSION=0.1.0

DEBUG=True

# Use command `make generate-secret-key`
SECRET_KEY=change-me

LOG_LEVEL=INFO

# Database
POSTGRES_DB=docker_fullstack
POSTGRES_USER=docker_fullstack
POSTGRES_PASSWORD=docker_fullstack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

PASSWORD_MIN_LENGTH=8

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3010

# Environment
# dev: run migrations, collectstatic and periodic tasks
# prod: run migrations and periodic tasks
# ci: avoid running initial tasks in Github Actions
ENVIRONMENT=ci
