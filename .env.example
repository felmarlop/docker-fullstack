# Project configuration
# Copy this file to .env and adjust the values for your local environment.

# --------------------------------------------------------------------
# Environment
# --------------------------------------------------------------------

# dev: run migrations, collectstatic and periodic tasks
# prod: run migrations and periodic tasks
# ci: avoid running initial tasks
ENVIRONMENT=dev

# --------------------------------------------------------------------
# Application
# --------------------------------------------------------------------

APP_NAME=Docker Fullstack Boilerplate
APP_VERSION=0.1.0

# --------------------------------------------------------------------
# Docker
# --------------------------------------------------------------------

COMPOSE_PROJECT_NAME=docker-fullstack-dev

# --------------------------------------------------------------------
# Nginx
# --------------------------------------------------------------------

NGINX_PORT=8088

# --------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------

FRONTEND_PORT=3010
FRONTEND_URL=http://localhost:${NGINX_PORT}

VITE_APP_NAME=${APP_NAME}
VITE_API_URL=http://localhost:${NGINX_PORT}/api

# Set GitHub client ID for OAuth2 authentication
# https://github.com/settings/applications/new
VITE_GITHUB_CLIENT_ID=change-me

# Set Google client ID for OAuth2 authentication
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=change-me

# Set Stripe publishable key for payment processing
# https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=change-me

# --------------------------------------------------------------------
# Backend
# --------------------------------------------------------------------

DEBUG=True
# Run `make generate-django-secret-key` to generate a new secret key.
SECRET_KEY=change-me

# Set GitHub secret key for OAuth2 authentication
# https://github.com/settings/applications/new
GITHUB_SECRET_KEY=change-me
GITHUB_CLIENT_ID=${VITE_GITHUB_CLIENT_ID}
GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}

# Set Gemini API key for AI integration
# https://aistudio.google.com/api-keys
GEMINI_API_KEY=change-me

# Set Stripe secret key for payment processing if needed
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me

# Example subscriptions defined in backend/src/app/subscription/views/subscription.py
STRIPE_PRO_LIFETIME_PRICE_ID=change-me
STRIPE_PLUS_LIFETIME_PRICE_ID=change-me

BACKEND_PORT=8010

LOG_LEVEL=INFO

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed frontend origins
# (not needed if Nginx enabled)
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT}
CSRF_TRUSTED_ORIGINS=http://localhost:${NGINX_PORT}

SECURE_SSL_REDIRECT=False

PASSWORD_MIN_LENGTH=8

# --------------------------------------------------------------------
# Email
# --------------------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@localhost

# --------------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------------

POSTGRES_DB=docker_fullstack
POSTGRES_USER=docker_fullstack
POSTGRES_PASSWORD=docker_fullstack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# --------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# --------------------------------------------------------------------
# Celery
# --------------------------------------------------------------------

CELERY_BROKER_URL=redis://redis:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://redis:${REDIS_PORT}/0
