# Project configuration
# Copy this file to .env and adjust the values for your local environment.

# --------------------------------------------------------------------
# Environment
# --------------------------------------------------------------------

# dev: run migrations, collectstatic and periodic tasks
# prod: run migrations and periodic tasks
# ci: avoid running initial tasks
ENVIRONMENT=dev

# --------------------------------------------------------------------
# Application
# --------------------------------------------------------------------

APP_NAME=Docker Fullstack Boilerplate
APP_VERSION=0.1.0

# --------------------------------------------------------------------
# Docker
# --------------------------------------------------------------------

COMPOSE_PROJECT_NAME=docker-fullstack

# --------------------------------------------------------------------
# Nginx
# --------------------------------------------------------------------

NGINX_PORT=8088

# --------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------

FRONTEND_PORT=3010
FRONTEND_URL=http://localhost:${NGINX_PORT}

# --------------------------------------------------------------------
# Backend
# --------------------------------------------------------------------

DEBUG=True
SECRET_KEY=change-me

BACKEND_PORT=8010

LOG_LEVEL=INFO

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed frontend origins
# (not needed if Nginx enabled)
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT}
CSRF_TRUSTED_ORIGINS=http://localhost:${NGINX_PORT}

PASSWORD_MIN_LENGTH=8

# --------------------------------------------------------------------
# Email
# --------------------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@localhost

# --------------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------------

POSTGRES_DB=docker_fullstack
POSTGRES_USER=docker_fullstack
POSTGRES_PASSWORD=docker_fullstack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# --------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# --------------------------------------------------------------------
# Celery
# --------------------------------------------------------------------

CELERY_BROKER_URL=redis://redis:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://redis:${REDIS_PORT}/0
