# Continuous Integration (CI) configuration
# This file is used by GitHub Actions to run the project in a CI environment.

# --------------------------------------------------------------------
# Environment
# --------------------------------------------------------------------

# dev: run migrations, collectstatic and periodic tasks
# prod: run migrations and periodic tasks
# ci: avoid running initial tasks
ENVIRONMENT=ci

# --------------------------------------------------------------------
# Application
# --------------------------------------------------------------------

APP_NAME=Docker Fullstack Boilerplate
APP_VERSION=0.1.0

# --------------------------------------------------------------------
# Nginx
# --------------------------------------------------------------------

NGINX_PORT=8088

# --------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------

FRONTEND_PORT=3010

STRIPE_PUBLISHABLE_KEY=change-me

# --------------------------------------------------------------------
# Backend
# --------------------------------------------------------------------

DEBUG=True
SECRET_KEY=change-me

GITHUB_SECRET_KEY=change-me
GITHUB_CLIENT_ID=change-me
GOOGLE_CLIENT_ID=change-me

STRIPE_SECRET_KEY=change-me

LOG_LEVEL=INFO

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated list of allowed frontend origins
# (not needed if Nginx enabled)
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT}
CSRF_TRUSTED_ORIGINS=http://localhost:${NGINX_PORT}

PASSWORD_MIN_LENGTH=8

# --------------------------------------------------------------------
# Email
# --------------------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost

# --------------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------------

POSTGRES_DB=docker_fullstack
POSTGRES_USER=docker_fullstack
POSTGRES_PASSWORD=docker_fullstack
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------------------------------
# Celery
# --------------------------------------------------------------------

CELERY_BROKER_URL=redis://redis:${REDIS_PORT}/0
CELERY_RESULT_BACKEND=redis://redis:${REDIS_PORT}/0
